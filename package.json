{
  "name": "@dsh-external/dsh-oauth-mcp-client",
  "version": "0.1.0",
  "description": "OAuth-enabled Streamable HTTP MCP client plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "README.zh-CN.md",
    "springbrand.cordis.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springbrand-lab/dsh-oauth-mcp-client.git"
  },
  "homepage": "https://github.com/springbrand-lab/dsh-oauth-mcp-client#readme",
  "bugs": {
    "url": "https://github.com/springbrand-lab/dsh-oauth-mcp-client/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "oauth"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./springbrand.cordis.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
